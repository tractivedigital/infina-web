# Copy to ~/infina-web/.env.production on the server and fill in. Never commit the real file (it is git-ignored).
# Values with spaces must be quoted.

# --- Sub-path build (UAT). Remove these three lines for the final production build. ---
NEXT_PUBLIC_BASE_PATH=/infina-new
NEXT_PUBLIC_NOINDEX=1
NEXT_PUBLIC_SITE_URL=https://chatbot.infina.co.in/infina-new

# --- E-mail: every form submission is sent here through Gmail SMTP ---
SMTP_USER=
SMTP_APP_PASSWORD=""
MAIL_TO=connect@infina.in
MAIL_FROM_NAME="Infina Website"

# --- Runtime ---
PORT=3001
