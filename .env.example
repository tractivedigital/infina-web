# Public site URL used for canonical links, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.infina.co.in

# Where form submissions (eligibility enquiries, Diwali offer, channel partner applications) are sent.
# HTTPS endpoint that accepts a JSON POST: CRM API, Power Automate / Zapier / Make webhook, mail relay...
# Without it submissions are only written to the server log.
FORM_WEBHOOK_URL=
# Optional. When set, each request carries "X-Infina-Signature: sha256=<HMAC-SHA256 of the body>".
FORM_WEBHOOK_SECRET=
